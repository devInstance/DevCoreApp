<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<AssemblyName>DevInstance.DevCoreApp.Client.Desktop</AssemblyName>
		<RootNamespace>DevInstance.DevCoreApp.Client.Desktop</RootNamespace>
		<Configurations>Debug;Release;ServiceMocks</Configurations>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DevInstance.BlazorToolkit" Version="10.5.0" />
		<PackageReference Include="DevInstance.LogScope.NET" Version="10.1.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
		<PackageReference Include="DartSassBuilder" Version="1.1.0" />
	</ItemGroup>

	<!-- Dev-only (DevServers origin map for the standalone dev server); never ship it. Removing it from
	     Content also keeps it out of the static web asset set, where a release build can see it twice
	     ("More than one compatible asset found for target path 'appsettings.Development...json'"). -->
	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<Content Remove="wwwroot\appsettings.Development.json" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Client.Services\Client.Services.csproj" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\..\mocks\Client\Client.Services.Mocks\Client.Services.Mocks.csproj" Condition="'$(Configuration)' == 'ServiceMocks'" />
	</ItemGroup>

	<!-- TypeScript: sources in Scripts/, compiled JS committed to wwwroot/scripts/ (same setup as the
	     server project). Runs tsc only when a .ts file is newer than its .js output. -->
	<PropertyGroup>
		<TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
	</PropertyGroup>
	<ItemGroup>
		<TypeScriptSource Include="Scripts\**\*.ts" Exclude="Scripts\**\*.d.ts" />
		<TypeScriptInput Include="Scripts\**\*.ts" />
		<TypeScriptInput Include="tsconfig.json" />
	</ItemGroup>
	<Target Name="CompileTypeScript" BeforeTargets="BeforeBuild"
	        Inputs="@(TypeScriptInput)"
	        Outputs="@(TypeScriptSource->'wwwroot\scripts\%(Filename).js')">
		<!-- A fresh checkout (CI) has arbitrary timestamps, so this target can fire with no tsc on the
		     agent. Fall back to the committed JS when tsc is absent; fail only on a real compile error. -->
		<Exec Command="tsc --version" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
			<Output TaskParameter="ExitCode" PropertyName="TscCheckCode" />
		</Exec>
		<Message Condition="'$(TscCheckCode)' != '0'" Importance="high"
		         Text="tsc not found — skipping TypeScript compilation. Committed JS files will be used. Install tsc (npm i -g typescript) to compile locally." />
		<Exec Condition="'$(TscCheckCode)' == '0'" Command="tsc -p tsconfig.json" IgnoreExitCode="true">
			<Output TaskParameter="ExitCode" PropertyName="TscExitCode" />
		</Exec>
		<Error Condition="'$(TscCheckCode)' == '0' AND '$(TscExitCode)' != '0'"
		       Text="TypeScript compilation failed (exit code $(TscExitCode)). Run: tsc -p tsconfig.json" />
	</Target>

	<!-- SCSS: DartSassBuilder compiles Styles/app.scss; the result is served from wwwroot. -->
	<Target Name="CopySassOutput" AfterTargets="DartSass_Build">
		<Copy SourceFiles="Styles\app.css" DestinationFolder="wwwroot" />
	</Target>

</Project>
