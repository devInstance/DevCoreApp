@page "/account/reset-password"
@using DevInstance.DevCoreApp.Client.Services.Core.Account
@using DevInstance.DevCoreApp.Shared.Model.Core.Account
@inject IAccountService Account

<PageTitle>Reset password</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-4 text-center">Reset password</h1>

                @if (string.IsNullOrEmpty(Code))
                {
                    <div class="alert alert-danger" role="alert">This password reset link is incomplete. Request a new one.</div>
                    <div class="text-center"><a href="account/forgot-password" class="text-decoration-none">Forgot your password?</a></div>
                }
                else if (done)
                {
                    <div class="alert alert-success" role="alert">Your password has been reset. You can now log in.</div>
                    <div class="text-center"><a href="account/login" class="btn btn-primary">Log in</a></div>
                }
                else
                {
                    @if (Host.IsError)
                    {
                        <div class="alert alert-danger" role="alert">@Host.ErrorMessage</div>
                    }

                    <EditForm Model="Input" OnValidSubmit="ResetAsync">
                        <DataAnnotationsValidator />
                        <div class="form-floating mb-3">
                            <InputText @bind-Value="Input.Email" id="email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                            <label for="email">Email</label>
                            <ValidationMessage For="() => Input.Email" class="text-danger" />
                        </div>
                        <div class="form-floating mb-3">
                            <InputText type="password" @bind-Value="Input.Password" id="password" class="form-control" autocomplete="new-password" placeholder="password" />
                            <label for="password">New password</label>
                            <ValidationMessage For="() => Input.Password" class="text-danger" />
                        </div>
                        <div class="form-floating mb-3">
                            <InputText type="password" @bind-Value="Input.ConfirmPassword" id="confirmPassword" class="form-control" autocomplete="new-password" placeholder="password" />
                            <label for="confirmPassword">Confirm password</label>
                            <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
                        </div>
                        <button type="submit" class="w-100 btn btn-primary" disabled="@Host.InProgress">Reset password</button>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private IServiceExecutionHost Host { get; set; } = default!;

    /// <summary>The code from the emailed link, passed to the server exactly as received.</summary>
    [SupplyParameterFromQuery] private string? Code { get; set; }

    private ResetPasswordParameters Input { get; } = new();
    private bool done;

    // Before validation runs: Code is [Required] on the form model.
    protected override void OnParametersSet() => Input.Code = Code ?? "";

    private async Task ResetAsync()
    {
        await Host.ServiceSubmitAsync(async () => await Account.ResetPasswordAsync(Input), _ => done = true);
    }
}
