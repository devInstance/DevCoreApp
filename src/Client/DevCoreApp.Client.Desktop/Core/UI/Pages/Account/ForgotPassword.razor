@page "/account/forgot-password"
@using DevInstance.DevCoreApp.Client.Services.Core.Account
@using DevInstance.DevCoreApp.Shared.Model.Core.Account
@inject IAccountService Account

<PageTitle>Forgot your password?</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-4 text-center">Forgot your password?</h1>

                @if (sent)
                {
                    @* Same message whether or not the address has an account (no account probing). *@
                    <div class="alert alert-success" role="alert">
                        If an account exists for that email, a link to reset the password has been sent.
                    </div>
                    <div class="text-center"><a href="account/login" class="text-decoration-none">Back to log in</a></div>
                }
                else
                {
                    @if (Host.IsError)
                    {
                        <div class="alert alert-danger" role="alert">@Host.ErrorMessage</div>
                    }

                    <EditForm Model="Input" OnValidSubmit="SendAsync">
                        <DataAnnotationsValidator />
                        <div class="form-floating mb-3">
                            <InputText @bind-Value="Input.Email" id="email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                            <label for="email">Email</label>
                            <ValidationMessage For="() => Input.Email" class="text-danger" />
                        </div>
                        <button type="submit" class="w-100 btn btn-primary mb-3" disabled="@Host.InProgress">Send reset link</button>
                        <div class="text-center"><a href="account/login" class="text-decoration-none">Back to log in</a></div>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private IServiceExecutionHost Host { get; set; } = default!;

    private ForgotPasswordParameters Input { get; } = new();
    private bool sent;

    private async Task SendAsync() =>
        await Host.ServiceSubmitAsync(async () => await Account.SendPasswordResetLinkAsync(Input), _ => sent = true);
}
