<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
		<NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
		<!-- Served under /mobile by the server (and by `dotnet run` standalone): must match <base href> in index.html. -->
		<StaticWebAssetBasePath>mobile</StaticWebAssetBasePath>
		<AssemblyName>DevInstance.DevCoreApp.Client.Mobile</AssemblyName>
		<RootNamespace>DevInstance.DevCoreApp.Client.Mobile</RootNamespace>
		<Configurations>Debug;Release;ServiceMocks</Configurations>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DevInstance.BlazorToolkit" Version="10.5.0" />
		<PackageReference Include="DevInstance.LogScope.NET" Version="10.1.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
	</ItemGroup>

	<!-- Dev-only (DevServers origin map for the standalone dev server); never ship it. Removing it from
	     Content also keeps it out of the static web asset set, where a release build can see it twice
	     ("More than one compatible asset found for target path 'appsettings.Development...json'"). -->
	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<Content Remove="wwwroot\appsettings.Development.json" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Client.Services\Client.Services.csproj" />
	</ItemGroup>

	<ItemGroup>
		<ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
	</ItemGroup>

</Project>
