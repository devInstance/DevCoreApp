@using DevInstance.DevCoreApp.Server.Admin.WebService.Core.UI.Components.Account
<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Core.UI.Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Core.UI.Layout.MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
